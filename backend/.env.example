PORT=3001
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hiMEv2?retryWrites=true&w=majority

STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

JWT_SECRET_KEY=your_jwt_secret_key
NODE_ENV=development

# Option 1 (Recommended for Render/Vercel): Resend HTTPS API (Port 443, never blocked)
RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM="hiMEStream" <onboarding@resend.dev>

# Option 2: SMTP / Gmail (Port 465 with SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="hiMEStream" <your_email@gmail.com>
